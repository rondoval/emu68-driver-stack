; emu68 Driver Stack Installer
; Requires Commodore Installer v43.3 or later.
; SPDX-License-Identifier: GPL-2.0+
;
; NOTE: this is a template.  The build's `package` target generates the real
; `Install` from it, substituting @PACKAGE_VERSION@ from the CMake project
; version and @RANGEOPS_BUILD@ (0/1) from the cache-op flavor.
;
; TEXT BUDGET - the Installer word-wraps display text at about 53 characters
; (topaz 8; it is really a pixel width, so a wider screen font wraps sooner)
; into a text area roughly ten lines tall, and pages the overflow behind a
; "More" button.  Therefore:
;   (message) (prompt) (abort)  must fit ONE page: <= 10 lines of <= 50 columns
;   (help)                      may run to ~12 of our lines (it pages) before
;                               the appended @...-help builtin
;   (choices) labels            <= 40 characters - a gadget label must not wrap
; Blank separator lines count.  Anything that does not fit belongs in the
; ReadMe or in the question's (help).

(set #emu68-version "@PACKAGE_VERSION@")
(set #rangeops-build @RANGEOPS_BUILD@)

; A system-wide install spread across LIBS:, DEVS: and C:; there is no single
; application directory.  Point @default-dest at SYS: so the Installer's closing
; report reads sensibly.
(set @default-dest "SYS:")

; Require Installer v43.3+ (askoptions, askchoice, copylib-style version checking, IN).
; 2818051 = (43 << 16) | 3.
(if (< @installer-version 2818051)
    (
        (message
            (cat
                "This installer needs Commodore Installer v43.3\n"
                "or later.  Please update the Installer tool and\n"
                "try again."
            )
            (all)
        )
        (exit (quiet))
    )
)

; ---------------------------------------------------------------------------
; Helper procedures
; ---------------------------------------------------------------------------

; P_copyver - install one versioned file (library or device) safely.
; Upgrades automatically when the bundled copy is newer; if an equal or newer
; copy is already installed, asks before replacing it.  getversion returns 0 for
; a missing file, so a fresh install always copies.  (optional "force") clears a
; delete-protected destination left by a previous install.
; Returns 1 when it (re)installed the file, 0 when it kept the existing copy -
; callers use this to keep the paired CLI tool in lockstep with the binary.
(procedure P_copyver #cv_src #cv_destdir #cv_name
    (set #cv_dest (tackon #cv_destdir #cv_name))
    (set #cv_do 1)
    (if (exists #cv_dest (noreq))
        (if (>= (getversion #cv_dest) (getversion #cv_src))
            (set #cv_do
                (askbool
                    (prompt
                        (cat
                            "An equal or newer " #cv_name "\n"
                            "is already installed in " #cv_destdir "\n\n"
                            "Replace it with the bundled version?"
                        )
                    )
                    (help @copylib-help)
                    (default 0)
                )
            )
        )
    )
    (if #cv_do
        (copyfiles
            (prompt (cat "Installing " #cv_name "..."))
            (help @copylib-help)
            (source #cv_src)
            (dest #cv_destdir)
            (optional "force")
        )
    )
    ; Procedure return value: 1 if we copied, 0 if we kept the existing file.
    #cv_do
)

; P_copyforce - unconditional force-copy of a file into a destination drawer, with
; no version check.  Used for the CLI tools (kept in lockstep with the binary they
; talk to) and for the two files that can legitimately be DOWNGRADED: the chosen
; genet.device variant (switching netdev 4.x <-> SANA-II 3.x is a same-name version
; change P_copyver would refuse) and the lwip-amiga bsdsocket.library (which must
; replace whatever incompatible bsdsocket a third-party stack installed).
(procedure P_copyforce #ct_src #ct_destdir
    (copyfiles
        (prompt (cat "Installing " (fileonly #ct_src) "..."))
        (help @copyfiles-help)
        (source #ct_src)
        (dest #ct_destdir)
        (optional "force")
    )
)

; P_backup - back up an existing file to <name>.orig before it is overwritten,
; but only once (never clobber an existing .orig).  Used before the netdev line
; force-replaces bsdsocket.library, so a later switch to a SANA-II stack can
; restore the user's original TCP/IP library.
(procedure P_backup #bk_dir #bk_name
    (set #bk_src (tackon #bk_dir #bk_name))
    (if (AND (exists #bk_src (noreq))
             (NOT (exists (tackon #bk_dir (cat #bk_name ".orig")) (noreq))))
        (copyfiles
            (prompt (cat "Backing up " #bk_name " to " #bk_name ".orig..."))
            (help @copyfiles-help)
            (source #bk_src)
            (dest #bk_dir)
            (newname (cat #bk_name ".orig"))
            (optional "force")
        )
    )
)

; ---------------------------------------------------------------------------
; Welcome
; ---------------------------------------------------------------------------
(message
    (cat
        "Welcome to the emu68 Driver Stack installer.\n"
        "Version " #emu68-version "\n\n"
        "AmigaOS drivers for the Raspberry Pi 4 / CM4\n"
        "running Emu68: USB (xhci), Gigabit Ethernet\n"
        "(genet + TCP/IP stack), NVMe storage, and the\n"
        "PCIe and interrupt libraries they need.\n\n"
        "You choose the parts you want on the next few\n"
        "screens; the ReadMe describes each one."
    )
    (all)
)

; ---------------------------------------------------------------------------
; Firmware capability gate (rangeops archives only).  The drivers in this
; archive emit inline Emu68 range cache opcodes; C/emu68check asks the
; firmware (via devicetree.resource) whether it decodes them.  (safe) makes
; the probe run in PRETEND mode too - it is query-only.
;   RC 0  capability advertised             -> proceed
;   RC 5  Emu68 without the extensions      -> abort (wrong archive here)
;   RC 10 no devicetree.resource            -> not under Emu68: warn, ask
; Other values (e.g. a corrupt tool) fall through - fail open.
; ---------------------------------------------------------------------------
(if #rangeops-build
    (
        (set #rangeops-rc (run "C/emu68check RANGEOPS" (safe)))
        (if (= #rangeops-rc 5)
            (abort
                (cat
                    "Wrong archive for this machine.\n\n"
                    "The xhci, genet and nvme drivers here use\n"
                    "inline Emu68 cache opcodes that your Emu68\n"
                    "does not support, so they would refuse to\n"
                    "load after installation.\n\n"
                    "Install the standard (non-rangeops) archive,\n"
                    "or boot a custom Emu68 build carrying the\n"
                    "dcache extensions and try again."
                )
            )
        )
        (if (= #rangeops-rc 10)
            (if (NOT (askbool
                        (prompt
                            (cat
                                "Emu68 was not detected here (there is no\n"
                                "devicetree.resource), so the firmware feature\n"
                                "these drivers need cannot be verified.\n\n"
                                "If you are preparing a disk for a PiStorm\n"
                                "machine, make sure it boots a custom Emu68\n"
                                "carrying the dcache extensions - otherwise\n"
                                "use the standard archive.\n\n"
                                "Continue installing anyway?"
                            )
                        )
                        (help
                            "Installing from a machine that is not the\n"
                            "target (or not running Emu68 at all) is fine -\n"
                            "the check simply cannot run here."
                        )
                        (default 0)
                    ))
                (abort
                    "Installation cancelled: the rangeops firmware\n"
                    "requirement could not be verified."
                )
            )
        )
    )
)

; ---------------------------------------------------------------------------
; Component selection
;
; gic400.library and bcmpcie.library can be ticked to install them on their own
; (for other PCIe software), but any selected driver pulls in the libraries it
; needs automatically - you can never end up with a driver whose library is
; missing.  The library boxes therefore default OFF: leave them unticked and the
; drivers bring the libraries along.
;
; Ethernet (genet) and USB (xhci) are NOT in this list - each is a
; mutually-exclusive line choice asked separately below, because the two
; variants of each cannot coexist.
; ---------------------------------------------------------------------------

; Bit layout of the selection mask:
;   0 gic400.library  1 bcmpcie.library  2 nvme  3 lspci
; Default 12 = bits 2..3 (nvme + lspci); libraries derived as needed.
(if (= @user-level 0)
    (set #features 12)                       ; NOVICE: install the recommended set silently
    (set #features
        (askoptions
            (prompt "Select the components to install:")
            (help
                "nvme.device and lspci are ticked by default.\n\n"
                "gic400.library and bcmpcie.library are needed\n"
                "by the drivers and are installed automatically\n"
                "with them - tick a library only if you want it\n"
                "on its own, with no driver.\n\n"
                "USB and Ethernet are chosen in the next steps.\n\n"
                @askoptions-help
            )
            (choices
                "gic400.library  (interrupt controller)"
                "bcmpcie.library (PCIe bus)"
                "nvme.device     (NVMe storage)"
                "lspci           (PCIe diagnostic tool)"
            )
            (default 12)
        )
    )
)

(set #sel-gic400    (IN #features 0))
(set #sel-bcmpcie   (IN #features 1))
(set #install-nvme  (IN #features 2))
(set #install-lspci (IN #features 3))

; ---------------------------------------------------------------------------
; USB line - one mutually-exclusive choice.
;
; The 6.x driver implements only the context HCD ABI of Poseidon for AmigaOS
; 6.x.  The 5.x driver speaks the classic Poseidon HCD ABI, which Poseidon 6.x
; also retains - so 5.x runs on both stacks, while 6.x needs the new one.  Both
; are called xhci.device, so exactly one USB line can be installed.  Poseidon
; itself is NOT part of this archive.
; ---------------------------------------------------------------------------
(if (= @user-level 0)
    (set #usb-choice 0)                      ; NOVICE: the current 6.x line
    (set #usb-choice
        (askchoice
            (prompt "USB (xhci.device):")
            (help
                "Choose ONE USB line - Poseidon is distributed\n"
                "separately, so pick by the one you have.\n\n"
                "  6.x - needs Poseidon for AmigaOS 6.x.  Real\n"
                "    USB 3.0 plus bulk streams (fast UAS mass\n"
                "    storage); the best choice there.\n\n"
                "  5.x - required on classic Poseidon 4.x, and\n"
                "    runs on 6.x too, but SuperSpeed appears as\n"
                "    USB 2.0 with no streams - the slower one.\n\n"
                @askchoice-help
            )
            (choices
                "xhci 6.x  (Poseidon for AmigaOS 6.x)"
                "xhci 5.x  (Poseidon 4.x, or 6.x slower)"
                "None - no USB driver"
            )
            (default 0)
        )
    )
)
(set #usb-context  (= #usb-choice 0))
(set #usb-legacy   (= #usb-choice 1))
(set #install-xhci (OR #usb-context #usb-legacy))

; ---------------------------------------------------------------------------
; Ethernet line - one mutually-exclusive choice.
;
; A SANA-II TCP/IP stack cannot open the netdev driver and the lwip-amiga stack
; cannot open a SANA-II driver, so exactly one Ethernet line can be installed.
; ---------------------------------------------------------------------------
(if (= @user-level 0)
    (set #net-choice 0)                      ; NOVICE: netdev + lwip-amiga
    (set #net-choice
        (askchoice
            (prompt "Ethernet and TCP/IP:")
            (help
                "Choose ONE networking option - they are\n"
                "mutually exclusive.\n\n"
                "  netdev + lwip-amiga - the modern zero-copy\n"
                "    genet.device 4.x plus the bundled\n"
                "    bsdsocket.library.  Installing it REPLACES\n"
                "    any bsdsocket.library you use now.\n\n"
                "  SANA-II - the classic genet.device 3.x for a\n"
                "    third-party stack (Roadshow, AmiTCP,\n"
                "    Miami).  Leaves bsdsocket.library alone.\n\n"
                @askchoice-help
            )
            (choices
                "netdev genet 4.x + lwip-amiga stack"
                "SANA-II genet 3.x (third-party stack)"
                "None - no Ethernet driver"
            )
            (default 0)
        )
    )
)
(set #net-netdev    (= #net-choice 0))
(set #net-sana2     (= #net-choice 1))
(set #install-genet (OR #net-netdev #net-sana2))

; openpci.library - optional, off by default, never offered to a NOVICE.
(if (= @user-level 0)
    (set #install-openpci 0)
    (set #install-openpci
        (askbool
            (prompt
                (cat
                    "Install openpci.library?  (optional)\n\n"
                    "A compatibility shim for software that opens\n"
                    "'openpci.library' by name.\n\n"
                    "WARNING: do NOT install it if you have a real\n"
                    "PCI board (Mediator, Prometheus, G-REX ...) -\n"
                    "the name clash breaks that board's driver."
                )
            )
            (help
                "openpci.library is only needed by older software\n"
                "that opens 'openpci.library' by name and expects\n"
                "the classic openpci API.  It forwards those\n"
                "calls to bcmpcie.library.  New software should\n"
                "use bcmpcie.library directly."
            )
            (default 0)
        )
    )
)

; The netdev line replaces the user's bsdsocket.library.  Make them accept that
; explicitly - declining aborts, since a netdev install without the stack is
; useless and we must not silently overwrite their TCP/IP library.  This gate runs
; before anything is installed.
(if #net-netdev
    (if (NOT
            (askbool
                (prompt
                    (cat
                        "The netdev option installs lwip-amiga's\n"
                        "bsdsocket.library, REPLACING the one you use\n"
                        "now.  Any SANA-II TCP/IP stack (Roadshow,\n"
                        "AmiTCP, Miami) stops working until you\n"
                        "switch back.\n\n"
                        "Your current bsdsocket.library is backed up\n"
                        "to bsdsocket.library.orig first.\n\n"
                        "Replace bsdsocket.library?"
                    )
                )
                (help
                    "bsdsocket.library is the AmigaOS TCP/IP API\n"
                    "library and only one can be active.  Choose\n"
                    "the SANA-II option instead to keep your\n"
                    "existing stack."
                )
                (default 1)
            )
        )
        (abort
            (cat
                "Installation cancelled: the netdev option needs\n"
                "to replace bsdsocket.library, and you declined.\n\n"
                "Run the installer again and choose the SANA-II\n"
                "driver or None."
            )
        )
    )
)

; ---------------------------------------------------------------------------
; Dependency resolution (union of explicit selection and derived needs)
; ---------------------------------------------------------------------------
(set #need-bcmpcie (OR #sel-bcmpcie #install-xhci #install-nvme #install-lspci #install-openpci))
(set #any-component (OR #need-bcmpcie #install-genet #sel-gic400))

; gic400 is needed by every driver, so install it like any other library in the
; stack whenever anything is selected.  P_copyver still refuses to overwrite an
; equal or newer LIBS: copy without asking.  Note the LIBS: copy goes unused on
; a machine whose Emu68 supplies gic400.library from its ROM board (that copy is
; already in exec's library list, so OpenLibrary never reaches LIBS:) - the
; closing message says so.
(set #install-gic400 #any-component)

; Nothing selected at all - nothing to do.
(if (NOT #any-component)
    (
        (message
            (cat
                "No components were selected, so nothing has\n"
                "been installed.\n\n"
                "Run the installer again and select at least\n"
                "one component."
            )
        )
        (exit (quiet))
    )
)

; ---------------------------------------------------------------------------
; Disk-space check (safety net - the binaries are small).  genet and its tools
; come from a different subtree per variant, so size the chosen one.
; ---------------------------------------------------------------------------
(set #need-libs 0)
(set #need-devs 0)
(set #need-c 0)
(if #install-gic400  (set #need-libs (+ #need-libs (getsize "LIBS/gic400.library"))))
(if #need-bcmpcie    (set #need-libs (+ #need-libs (getsize "LIBS/bcmpcie.library"))))
(if #install-openpci (set #need-libs (+ #need-libs (getsize "LIBS/openpci.library"))))
(if #usb-context     (set #need-devs (+ #need-devs (getsize "DEVS/USBHardware/xhci.device"))))
(if #usb-legacy      (set #need-devs (+ #need-devs (getsize "Storage/DEVS/USBHardware/xhci.device"))))
(if #net-netdev      (set #need-devs (+ #need-devs (getsize "DEVS/Networks/genet.device"))))
(if #net-sana2
    (
        (set #need-devs (+ #need-devs (getsize "Storage/DEVS/Networks/genet.device")))
        (set #need-c    (+ #need-c (getsize "Storage/C/genet-stats")))
    )
)
(if #install-nvme
    (
        (set #need-devs (+ #need-devs (getsize "DEVS/nvme.device")))
        (set #need-c    (+ #need-c (getsize "C/nvmeinfo")))
        (set #need-c    (+ #need-c (getsize "C/nvmeadm")))
    )
)
(if #install-lspci   (set #need-c (+ #need-c (getsize "C/lspci"))))
(if #net-netdev
    (
        (set #need-libs (+ #need-libs (getsize "LIBS/bsdsocket.library")))
        (set #need-c    (+ #need-c (getsize "C/netdev-stats")))
        (set #need-c    (+ #need-c (getsize "C/netinfo")))
        (set #need-c    (+ #need-c (getsize "C/mdns")))
    )
)

; getdiskspace returns -1 when it cannot tell; only abort on a real shortfall.
(set #free (getdiskspace "LIBS:"))
(if (AND (> #need-libs 0) (AND (>= #free 0) (< #free #need-libs)))
    (abort "Not enough free space in LIBS: to install\n"
           "the selected libraries.")
)
(set #free (getdiskspace "DEVS:"))
(if (AND (> #need-devs 0) (AND (>= #free 0) (< #free #need-devs)))
    (abort "Not enough free space in DEVS: to install\n"
           "the selected drivers.")
)
(set #free (getdiskspace "C:"))
(if (AND (> #need-c 0) (AND (>= #free 0) (< #free #need-c)))
    (abort "Not enough free space in C: to install\n"
           "the selected tools.")
)

; ---------------------------------------------------------------------------
; Installation
; ---------------------------------------------------------------------------
(complete 0)

; Track whether bcmpcie.library was actually (re)installed, so lspci can follow it
; (selecting lspci forces #need-bcmpcie, so this is always set when lspci is on).
(set #did-bcmpcie 0)

; Libraries -> LIBS:
(if #install-gic400  (P_copyver "LIBS/gic400.library"  "LIBS:" "gic400.library"))
(if #need-bcmpcie    (set #did-bcmpcie (P_copyver "LIBS/bcmpcie.library" "LIBS:" "bcmpcie.library")))
(if #install-openpci (P_copyver "LIBS/openpci.library" "LIBS:" "openpci.library"))
(complete 30)

; Devices -> DEVS:
; xhci.device - force-copy the chosen line (a line switch is a same-name version
; change, so version-checked copy would refuse the 6.x -> 5.x direction).
(if #install-xhci
    (
        (makedir "DEVS:USBHardware")
        (if #usb-context
            (P_copyforce "DEVS/USBHardware/xhci.device" "DEVS:USBHardware")
            (P_copyforce "Storage/DEVS/USBHardware/xhci.device" "DEVS:USBHardware")
        )
    )
)

; genet.device - force-copy the chosen variant (a variant switch is a same-name
; version change, so version-checked copy would refuse a downgrade).
(if #install-genet
    (
        (makedir "DEVS:Networks")
        (if #net-netdev
            (P_copyforce "DEVS/Networks/genet.device" "DEVS:Networks")
            (P_copyforce "Storage/DEVS/Networks/genet.device" "DEVS:Networks")
        )
    )
)

(if #install-nvme
    (
        (set #did-nvme (P_copyver "DEVS/nvme.device" "DEVS:" "nvme.device"))
        ; nvmeinfo / nvmeadm - diagnostic and admin tools, kept in lockstep with the driver.
        (if #did-nvme
            (
                (P_copyforce "C/nvmeinfo" "C:")
                (P_copyforce "C/nvmeadm" "C:")
            )
        )
    )
)
(complete 55)

; netdev line -> LIBS:bsdsocket.library (backed up, then force-replaced), its
; tools, and the config template.  The template lands in ENVARC: only when no
; netstack.prefs exists yet - a reinstall never clobbers a live configuration.
(if #net-netdev
    (
        (P_backup "LIBS:" "bsdsocket.library")
        (P_copyforce "LIBS/bsdsocket.library" "LIBS:")
        (P_copyforce "C/netdev-stats" "C:")
        (P_copyforce "C/netinfo" "C:")
        (P_copyforce "C/mdns" "C:")
        (if (NOT (exists "ENVARC:netstack.prefs" (noreq)))
            (copyfiles
                (prompt "Installing the default netstack.prefs (DHCP)...")
                (help @copyfiles-help)
                (source "ENVARC/netstack.prefs.default")
                (dest "ENVARC:")
                (newname "netstack.prefs")
            )
        )
    )
)

; SANA-II line -> the genet-stats counter tool, plus an offer to restore a
; bsdsocket.library that a previous netdev install backed up (so a third-party
; stack works again).  The SANA-II line installs no bsdsocket of its own.
(if #net-sana2
    (
        (P_copyforce "Storage/C/genet-stats" "C:")
        (if (exists "LIBS:bsdsocket.library.orig" (noreq))
            (if (askbool
                    (prompt
                        (cat
                            "A bsdsocket.library backed up by an earlier\n"
                            "netdev install was found.  Restore it so your\n"
                            "SANA-II stack (Roadshow, AmiTCP, Miami) works\n"
                            "again?"
                        )
                    )
                    (help @copyfiles-help)
                    (default 1)
                )
                (
                    (copyfiles
                        (prompt "Restoring bsdsocket.library...")
                        (help @copyfiles-help)
                        (source "LIBS:bsdsocket.library.orig")
                        (dest "LIBS:")
                        (newname "bsdsocket.library")
                        (optional "force")
                    )
                    (delete "LIBS:bsdsocket.library.orig")
                )
            )
        )
    )
)
(complete 80)

; Diagnostic tool -> C:.  Keep lspci in lockstep with bcmpcie.library: (re)install
; it when bcmpcie was just (re)installed, or when no lspci exists yet (honour an
; explicit selection).  Skip only when bcmpcie was kept AND an lspci already
; exists - that existing tool pairs with the library we left in place.
(if #install-lspci
    (if (OR #did-bcmpcie (NOT (exists "C:lspci" (noreq))))
        (P_copyforce "C/lspci" "C:")
    )
)
(complete 100)

; ---------------------------------------------------------------------------
; Done
; ---------------------------------------------------------------------------
; One headline, then at most one two-line note per topic that was installed,
; then the ReadMe pointer.  The usb-* and net-* notes are mutually exclusive,
; so the worst case (USB + Ethernet + gic400) is ten rendered lines - the
; whole budget.  Any note added here must displace another one.
(set #done-msg "Installation complete - reboot to activate.\n\n")
(if #usb-context
    (set #done-msg
        (cat #done-msg
            "* xhci 6.x needs Poseidon for AmigaOS 6.x; add\n"
            "  its units in Trident - see the ReadMe\n"
        )
    )
)
(if #usb-legacy
    (set #done-msg
        (cat #done-msg
            "* xhci 5.x needs a Poseidon USB stack; add\n"
            "  its units in Trident - see the ReadMe\n"
        )
    )
)
(if #net-netdev
    (set #done-msg
        (cat #done-msg
            "* TCP/IP configures itself by DHCP; settings\n"
            "  live in ENVARC:netstack.prefs\n"
        )
    )
)
(if #net-sana2
    (set #done-msg
        (cat #done-msg
            "* point a TCP/IP stack (Roadshow) at\n"
            "  genet.device unit 0 to carry traffic\n"
        )
    )
)
(if #install-gic400
    (set #done-msg
        (cat #done-msg
            "* LIBS:gic400.library goes unused if Emu68\n"
            "  supplies its own copy - harmless\n"
        )
    )
)
(set #done-msg (cat #done-msg "\nSee the ReadMe for usage notes."))
(message #done-msg (all))
