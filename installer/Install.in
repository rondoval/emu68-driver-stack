; emu68 Driver Stack Installer
; Requires Commodore Installer v43.3 or later.
; SPDX-License-Identifier: GPL-2.0+
;
; NOTE: this is a template.  The build's `package` target generates the real
; `Install` from it, substituting @PACKAGE_VERSION_DISPLAY@ (the CMake project
; version, plus the build stamp on a local build), @RANGEOPS_BUILD@ (0/1) from
; the cache-op flavor and @DEBUG_BACKEND@ (off, serial or pistorm) from the debug
; sink.
;
; TEXT BUDGET - the Installer word-wraps display text at about 53 characters
; (topaz 8; it is really a pixel width, so a wider screen font wraps sooner)
; into a text area roughly ten lines tall, and pages the overflow behind a
; "More" button.  Therefore:
;   (message) (prompt) (abort)  must fit ONE page: <= 10 lines of <= 50 columns
;   (help)                      may run to ~12 of our lines (it pages) before
;                               the appended @...-help builtin
;   (choices) labels            <= 40 characters - a gadget label must not wrap
; Blank separator lines count.  Anything that does not fit belongs in the
; ReadMe or in the question's (help).

(set #emu68-version "@PACKAGE_VERSION_DISPLAY@")
(set #rangeops-build @RANGEOPS_BUILD@)
(set #debug-backend "@DEBUG_BACKEND@")

; A system-wide install spread across LIBS:, DEVS: and C:; there is no single
; application directory.
(set @default-dest "SYS:")

; Require Installer v43.3+ (askoptions, askchoice, copylib-style version checking, IN).
; 2818051 = (43 << 16) | 3.
(if (< @installer-version 2818051)
    (
        (message
            (cat
                "This installer needs Commodore Installer v43.3\n"
                "or later.  Please update the Installer tool and\n"
                "try again."
            )
            (all)
        )
        (exit (quiet))
    )
)

; ---------------------------------------------------------------------------
; Helper procedures
; ---------------------------------------------------------------------------

; P_verstr - "version.revision" text of a getversion result.
(procedure P_verstr #vs_ver
    (cat (shiftright #vs_ver 16) "." (BITAND #vs_ver 65535))
)

; P_copyver - install one versioned file (library or device) safely.
; A newer bundled copy upgrades.  At the same version the checksum decides: an
; identical file is kept, a different one is replaced without asking - the
; standard, -rangeops and -serial archives of a release carry the same versions,
; so that is a switch between archives (or a rebuild), and keeping the old build
; would leave rangeops drivers that refuse to load on official Emu68.  Only an
; installed copy NEWER than the bundled one asks first.  getversion returns 0 for
; a missing file, so a fresh install always copies.  (optional "force") clears a
; delete-protected destination left by a previous install.
; Returns 1 when the installed file is now the bundled build (copied, or found
; identical), 0 when a newer copy was kept - callers use this to keep the paired
; CLI tool in lockstep with the binary.
(procedure P_copyver #cv_src #cv_destdir #cv_name
    (set #cv_dest (tackon #cv_destdir #cv_name))
    (set #cv_do 1)
    (set #cv_bundled 1)
    (if (exists #cv_dest (noreq))
        (
            (set #cv_have (getversion #cv_dest))
            (set #cv_new (getversion #cv_src))
            (if (> #cv_have #cv_new)
                (
                    (set #cv_do
                        (askbool
                            (prompt
                                (cat
                                    "The installed " #cv_name " is newer\n"
                                    "than the one in this archive:\n\n"
                                    "  installed: " (P_verstr #cv_have) " in " #cv_destdir "\n"
                                    "  this archive: " (P_verstr #cv_new) "\n\n"
                                    "Replace it with the older version?"
                                )
                            )
                            (help @copylib-help)
                            (default 0)
                        )
                    )
                    (set #cv_bundled #cv_do)
                )
                (if (AND (= #cv_have #cv_new) (= (getsum #cv_dest) (getsum #cv_src)))
                    (set #cv_do 0)
                )
            )
        )
    )
    (if #cv_do
        (copyfiles
            (prompt (cat "Installing " #cv_name "..."))
            (help @copylib-help)
            (source #cv_src)
            (dest #cv_destdir)
            (optional "force")
        )
    )
    #cv_bundled
)

; P_copyforce - unconditional force-copy of a file into a destination drawer, with
; no version check.  Used for the CLI tools (kept in lockstep with the binary they
; talk to) and for the two files that can legitimately be DOWNGRADED: the chosen
; genet.device variant (switching netdev 4.x -> SANA-II 3.x is a same-name version
; downgrade P_copyver would ask about) and the lwip-amiga bsdsocket.library (which must
; replace whatever incompatible bsdsocket a third-party stack installed).
(procedure P_copyforce #ct_src #ct_destdir
    (copyfiles
        (prompt (cat "Installing " (fileonly #ct_src) "..."))
        (help @copyfiles-help)
        (source #ct_src)
        (dest #ct_destdir)
        (optional "force")
    )
)

; ---------------------------------------------------------------------------
; Welcome - names the archive, so a wrong download shows on the first screen:
; the cache-op flavour, and the debug sink unless the build is silent.
; ---------------------------------------------------------------------------
(set #welcome-archive "Archive: standard (any Emu68 from 1.1 alpha.1)\n")
(if #rangeops-build
    (set #welcome-archive "Archive: -rangeops (needs the dcache extensions)\n")
)
(set #welcome-debug "")
(if (<> #debug-backend "off")
    (set #welcome-debug (cat "Diagnostic build (" #debug-backend " output): slower.\n"))
)
(set #welcome-next "The next screens ask what to install.")
(if (= @user-level 0)
    (set #welcome-next "Novice mode installs the recommended set.")
)
(message
    (cat
        "Welcome to the emu68 Driver Stack installer.\n"
        "Version " #emu68-version "\n\n"
        "Drivers for the Pi 4 / CM4 under Emu68: USB,\n"
        "Ethernet, TCP/IP, NVMe, VideoCore, PCIe.\n\n"
        #welcome-archive
        #welcome-debug
        "\n"
        #welcome-next
    )
    (all)
)

; ---------------------------------------------------------------------------
; Firmware capability check.  The -rangeops drivers emit inline Emu68 range
; cache opcodes; C/emu68check asks the firmware (via devicetree.resource)
; whether it decodes them.  (safe) makes the probe run in PRETEND mode too - it
; is query-only.  On a -rangeops archive:
;   RC 0  capability advertised             -> proceed
;   RC 5  Emu68 without the extensions      -> abort (wrong archive here)
;   RC 10 no devicetree.resource            -> not under Emu68: warn, ask
; On the standard archive RC 0 means the -rangeops one would serve this machine
; better: say so, and let the user carry on or abort.
; Other values (e.g. a corrupt tool) fall through - fail open.
; ---------------------------------------------------------------------------
(set #rangeops-rc (run "C/emu68check RANGEOPS" (safe)))
(if (AND (NOT #rangeops-build) (= #rangeops-rc 0))
    (message
        (cat
            "Your Emu68 has the dcache extensions, so the\n"
            "-rangeops archive of this release suits it\n"
            "better: its drivers do their cache work\n"
            "inline, which makes the netdev Ethernet driver\n"
            "with the bundled stack much faster.\n\n"
            "Proceed installs this archive anyway; Abort\n"
            "stops here, to fetch the -rangeops one."
        )
        (all)
    )
)
(if #rangeops-build
    (
        (if (= #rangeops-rc 5)
            (abort
                (cat
                    "Wrong archive for this machine.\n\n"
                    "The xhci, genet and nvme drivers here use\n"
                    "inline Emu68 cache opcodes that your Emu68\n"
                    "does not support, so they would refuse to\n"
                    "load after installation.\n\n"
                    "Install the standard (non-rangeops) archive,\n"
                    "or boot a custom Emu68 build carrying the\n"
                    "dcache extensions and try again."
                )
            )
        )
        (if (= #rangeops-rc 10)
            (if (NOT (askbool
                        (prompt
                            (cat
                                "Emu68 was not detected here (there is no\n"
                                "devicetree.resource), so the firmware feature\n"
                                "these drivers need cannot be verified.\n\n"
                                "If you are preparing a disk for a PiStorm\n"
                                "machine, make sure it boots a custom Emu68\n"
                                "carrying the dcache extensions - otherwise\n"
                                "use the standard archive.\n\n"
                                "Continue installing anyway?"
                            )
                        )
                        (help
                            "Installing from a machine that is not the\n"
                            "target (or not running Emu68 at all) is fine -\n"
                            "the check simply cannot run here."
                        )
                        (default 0)
                    ))
                (abort
                    "Installation cancelled: the rangeops firmware\n"
                    "requirement could not be verified."
                )
            )
        )
    )
)

; ---------------------------------------------------------------------------
; USB drivers - one box per line.
;
; xhci.device (6.x) implements only Neptune's own context HCD interface (Neptune:
; an incompatible fork of the Poseidon USB stack, 6.0-6.2 published as "Poseidon
; for AmigaOS").  xhci-legacy.device (5.x) speaks the classic V1/V2 interface,
; which Neptune also retains - so 5.x runs on Neptune and classic Poseidon 4.x,
; while 6.x needs Neptune.  Up to 5.5 the 5.x line was xhci.device too; the names
; now differ, so both can be installed.  No USB stack is part of this archive.
;
; The defaults follow what is installed.  #psd-classic: classic Poseidon 4.x is
; installed (its library reports below 6).  The 6.x box is ticked where Neptune can
; use it - an old 6.x xhci.device, Neptune installed, or no classic Poseidon (fresh,
; or Neptune on the 5.x driver, where 6.x is an upgrade) - but not on a Poseidon-only
; machine.  #xhci-old-5x: the installed xhci.device is a 5.x driver; with classic
; Poseidon it is Poseidon's and is not replaced unasked (the guard below).
; ---------------------------------------------------------------------------
(set #xhci-old (getversion "DEVS:USBHardware/xhci.device"))
(set #psd-ver (getversion "LIBS:poseidon.library"))
(set #xhci-old-5x (AND (> #xhci-old 0) (< #xhci-old 393216)))
(set #psd-classic (AND (> #psd-ver 0) (< #psd-ver 393216)))
; Bit 0 xhci.device (6.x), bit 1 xhci-legacy.device (5.x).
(set #usb-default 0)
(if (OR (>= #xhci-old 393216)
        (OR (exists "LIBS:neptune.library" (noreq)) (NOT #psd-classic)))
    (set #usb-default 1))
(if (OR #psd-classic (exists "DEVS:USBHardware/xhci-legacy.device" (noreq)))
    (set #usb-default (+ #usb-default 2)))
(if (= @user-level 0)
    (set #usb-choice #usb-default)           ; NOVICE: what the machine has
    (set #usb-choice
        (askoptions
            (prompt "USB host-controller drivers:")
            (help
                "The USB stack is distributed separately.\n\n"
                "  xhci.device (6.x) - needs Neptune 6.x: real\n"
                "    USB 3.0 and bulk streams (fast UAS mass\n"
                "    storage); the best choice there.\n\n"
                "  xhci-legacy.device (5.x) - for classic\n"
                "    Poseidon 4.x; runs on Neptune too, but\n"
                "    SuperSpeed appears as USB 2.0.\n\n"
                "Both can be installed; select the device in\n"
                "Trident or Neptune USB.\n\n"
                @askoptions-help
            )
            (choices
                "xhci.device  (6.x, Neptune)"
                "xhci-legacy.device  (5.x, Poseidon 4.x)"
            )
            (default #usb-default)
        )
    )
)
(set #usb-context (IN #usb-choice 0))
(set #usb-legacy  (IN #usb-choice 1))
; The 6.x driver would replace the xhci.device (5.x) classic Poseidon 4.x uses:
; only when asked, and then with xhci-legacy.device installed for Poseidon to
; switch to.
(if (AND #usb-context (AND #xhci-old-5x #psd-classic))
    (if (askbool
            (prompt
                "xhci.device here is the driver for classic\n"
                "Poseidon 4.x (version 5.5 or older).\n\n"
                "Installing the 6.x driver replaces it, and\n"
                "Poseidon then needs xhci-legacy.device\n"
                "(installed with it): select it in Trident.\n\n"
                "Replace xhci.device with the 6.x driver?"
            )
            (help
                "Answer No to keep Poseidon on its current\n"
                "xhci.device; the 6.x driver is then not\n"
                "installed.\n\n"
                @askbool-help
            )
            (default 0)
        )
        (set #usb-legacy 1)
        (set #usb-context 0)
    )
)
(set #install-xhci (OR #usb-context #usb-legacy))

; ---------------------------------------------------------------------------
; Ethernet driver (genet.device) - one mutually-exclusive choice: both variants
; carry the same file name, so only one of them can be installed.
;
;   netdev  4.x  zero-copy, and ONLY the bundled lwip-amiga stack can open it
;                - so this answer settles the TCP/IP question below.
;   SANA-II 3.x  the classic driver, usable by any TCP/IP stack - including the
;                bundled one, which drives Ethernet-type SANA-II devices since
;                lwip-amiga 1.5.
;
; The default follows the installed genet.device: 4.x is the netdev line, any
; older version a SANA-II driver.  With none installed the archive decides: netdev
; pays off only with the inline range ops, so the standard archive defaults to
; SANA-II (the ReadMe's WHAT TO INSTALL table).
; ---------------------------------------------------------------------------
(set #genet-old (getversion "DEVS:Networks/genet.device"))
(set #genet-default 1)                       ; SANA-II
(if (OR (>= #genet-old 262144)               ; 4.0
        (AND (= #genet-old 0) #rangeops-build))
    (set #genet-default 0)                   ; netdev
)
(if (= @user-level 0)
    (set #genet-choice #genet-default)       ; NOVICE: the default above
    (set #genet-choice
        (askchoice
            (prompt "Ethernet driver (genet.device):")
            (help
                "The Pi's onboard Gigabit port.  Both variants\n"
                "are called genet.device, so pick ONE.\n\n"
                "  netdev - fast zero-copy driver.  Only the\n"
                "    bundled lwip-amiga stack can open it, so\n"
                "    choosing it installs that stack too.\n\n"
                "  SANA-II - classic driver, works with any\n"
                "    TCP/IP stack: Roadshow, AmiTCP, Miami -\n"
                "    and the bundled one, slower than netdev.\n\n"
                @askchoice-help
            )
            (choices
                "netdev @GENET_VERSION@  (needs the bundled stack)"
                "SANA-II @GENET_SANA2_VERSION@  (any TCP/IP stack)"
                "None - no Ethernet driver"
            )
            (default #genet-default)
        )
    )
)
(set #net-netdev    (= #genet-choice 0))
(set #net-sana2     (= #genet-choice 1))
(set #install-genet (OR #net-netdev #net-sana2))

; ---------------------------------------------------------------------------
; TCP/IP stack - asked only when netdev was NOT chosen.  netdev genet.device
; can only be driven by the bundled lwip-amiga stack, so "netdev + keep my own
; stack" is a combination the user cannot reach; that is why no guard follows.
; The consent gate below still asks before another stack is replaced.
;
; C/emu68check BSDSOCKET tells whose LIBS:bsdsocket.library is installed: RC 0
; the bundled stack's, 5 another stack's, 10 none.  The default keeps what is
; there: the bundled stack when it is installed or no stack is, else leave
; alone.  (safe) runs the read-only probe in PRETEND mode too.  Any other RC (a
; corrupt tool) counts as another stack's, the safe side.
; ---------------------------------------------------------------------------
(set #bsd-rc (run "C/emu68check BSDSOCKET" (safe)))
(set #stack-ours (= #bsd-rc 0))
(set #stack-default 1)                       ; leave alone
(if (OR #stack-ours (= #bsd-rc 10))
    (set #stack-default 0)                   ; the bundled stack
)
(if #net-netdev
    (set #stack-choice 0)                    ; netdev implies the bundled stack
    (if (= @user-level 0)
        (set #stack-choice #stack-default)   ; NOVICE: the default above
        (set #stack-choice
            (askchoice
                (prompt "TCP/IP stack:")
                (help
                    "Only one bsdsocket.library can be active.\n\n"
                    "  lwip-amiga - the bundled stack.  Besides the\n"
                    "    netdev genet it drives Ethernet SANA-II\n"
                    "    drivers too (not PPP or SLIP), one\n"
                    "    interface at a time.  It REPLACES your\n"
                    "    bsdsocket.library and the Roadshow\n"
                    "    commands in C:\n\n"
                    "  Leave alone - installs no stack, and\n"
                    "    touches nothing in LIBS: or C:.\n\n"
                    @askchoice-help
                )
                (choices
                    "lwip-amiga  (the bundled stack)"
                    "Leave bsdsocket.library alone"
                )
                (default #stack-default)
            )
        )
    )
)
(set #install-stack (= #stack-choice 0))

; Installing the bundled stack over another one replaces that stack's
; bsdsocket.library and its commands in C:.  Make the user accept that
; explicitly, since we must not silently overwrite a TCP/IP library; an update
; of the bundled stack itself skips the question.  Keeping the current stack
; drops the bundled one, and with it the netdev genet.device, which nothing else
; can open: the SANA-II driver takes its place.  This gate runs before anything
; is installed, and it doubles as the netdev line's disclosure: netdev implies
; this stack.
(set #gate-ask "Replace them?")
(if #net-netdev
    (set #gate-ask
        (cat
            "Replace them?  Keeping your stack installs\n"
            "the SANA-II genet.device instead of netdev."
        )
    )
)
(if (AND #install-stack (NOT #stack-ours))
    (if (NOT
            (askbool
                (prompt
                    (cat
                        "The bundled stack installs lwip-amiga's\n"
                        "bsdsocket.library over any other TCP/IP stack\n"
                        "(Roadshow, AmiTCP, Miami) and its own ping,\n"
                        "traceroute, arp and AddNetInterface over the\n"
                        "Roadshow commands of those names in C:.\n\n"
                        "THIS CANNOT BE UNDONE from the installer.\n\n"
                        #gate-ask
                    )
                )
                (help
                    "bsdsocket.library is the AmigaOS TCP/IP API\n"
                    "library and only one can be active, and the\n"
                    "commands are Roadshow's own names.  Going back\n"
                    "means reinstalling Roadshow, AmiTCP or Miami.\n\n"
                    "Keep my stack leaves bsdsocket.library and\n"
                    "those commands untouched.  With the netdev\n"
                    "driver chosen it installs the SANA-II\n"
                    "genet.device instead: netdev works only with\n"
                    "the bundled stack, SANA-II with any.\n\n"
                    @askbool-help
                )
                (choices "Replace" "Keep my stack")
                (default 1)
            )
        )
        (
            (set #install-stack 0)
            (if #net-netdev
                (
                    (set #net-netdev 0)
                    (set #net-sana2 1)
                )
            )
        )
    )
)

; ---------------------------------------------------------------------------
; Upgrade note.  A 2.0-era ENVARC:netstack.prefs configured the interface
; itself (DEVICE, UNIT, MODE, ADDRESS, NETMASK, GATEWAY, VLAN).  2.1 ignores
; those keys - interfaces live in DEVS:NetInterfaces/ - so a static 2.0 setup
; would quietly come back up on DHCP.  Installer script language cannot read a
; file's contents, so detect the old layout by presence: the prefs file is
; there and the NetInterfaces drawer is not, which is exactly what 2.0 left
; behind.  Runs with the other pre-flight gates, before anything is installed.
; ---------------------------------------------------------------------------
(if (AND #install-stack
         (AND (exists "ENVARC:netstack.prefs" (noreq))
              (NOT (exists "DEVS:NetInterfaces" (noreq)))))
    (message
        (cat
            "An ENVARC:netstack.prefs from 2.0 was found.\n\n"
            "Interfaces are not configured there any more:\n"
            "DEVICE, UNIT, MODE, ADDRESS, NETMASK, GATEWAY\n"
            "and VLAN are ignored now, so a fixed address\n"
            "set up under 2.0 comes back up as DHCP.\n\n"
            "Your prefs file is left alone.  Put those\n"
            "settings in DEVS:NetInterfaces/genet after\n"
            "installing - the ReadMe shows the format."
        )
        (all)
    )
)

; ---------------------------------------------------------------------------
; Other components - asked after USB and the network, the parts most installs
; are for.  Tools have no boxes: each comes with the component it serves.
;
; gic400.library and bcmpcie.library can be installed on their own (for other
; PCIe software), but any selected driver pulls in the libraries it needs
; automatically - you can never end up with a driver whose library is missing.
; So only an EXPERT sees their boxes, unticked; below that the choice string is
; empty, which hides the box and keeps the bit numbering.
;
; openpci.library is the openpci API over bcmpcie.library, for programs such as
; identify.library that list PCI devices through it.  C/emu68check OPENPCI tells
; whose LIBS:openpci.library is installed: RC 0 ours, 5 another one, 10 none.
; Another one is most likely a real PCI board's (Mediator, Prometheus, G-REX),
; whose software ours would break, so the box is then unticked, and ticking it
; asks before replacing that library.  Any other RC counts as another one.
; ---------------------------------------------------------------------------

; Bit layout of the selection mask:
;   0 gic400.library  1 bcmpcie.library  2 openpci.library  3 nvme
;   4 videocodec  5 videocore.audio  6 vcjpeg.datatype
; Default 8 = bit 3 (nvme), plus bit 2 (openpci) unless another openpci.library
; is installed; libraries derived as needed.  videocodec (vchiq.device,
; videocodec.library, its backend and tools) is experimental: off.
; videocore.audio (an AHI driver on vchiq.device) needs videocodec and brings it
; along; off.  So does vcjpeg.datatype (JPEG pictures through videocodec); off.
(set #openpci-rc (run "C/emu68check OPENPCI" (safe)))
(set #openpci-other (AND (<> #openpci-rc 0) (<> #openpci-rc 10)))
(set #features-default 8)
(if (NOT #openpci-other) (set #features-default 12))
(set #choice-gic400 "")
(set #choice-bcmpcie "")
(set #help-libs "")
(if (= @user-level 2)
    (
        (set #choice-gic400 "gic400.library  (interrupt controller)")
        (set #choice-bcmpcie "bcmpcie.library (PCIe bus)")
        (set #help-libs
            (cat
                "gic400.library and bcmpcie.library are needed\n"
                "by the drivers and are installed automatically\n"
                "with them - tick a library only if you want it\n"
                "on its own, with no driver.\n\n"
            )
        )
    )
)
(if (= @user-level 0)
    (set #features #features-default)        ; NOVICE: install the recommended set silently
    (set #features
        (askoptions
            (prompt "Other components:")
            (help
                "nvme.device and openpci.library are ticked by\n"
                "default.  Tools come with what they serve:\n"
                "nvmeinfo and nvmeadm with nvme.device, lspci\n"
                "with the PCIe library, VCInfo with videocodec.\n\n"
                #help-libs
                "openpci.library lets programs that use the\n"
                "openpci API, such as identify.library, see the\n"
                "Pi's PCIe devices.  It is unticked when another\n"
                "openpci.library is installed - most likely a\n"
                "PCI board's, which this one would replace.\n\n"
                "videocodec (VideoCore video and pictures) is\n"
                "experimental and needs the cma overlay in the\n"
                "Pi's config.txt, and gpu_mem=192 there for\n"
                "pictures over 12 megapixels and two videos at\n"
                "once.\n\n"
                "videocore.audio is an AHI driver that plays\n"
                "through the VideoCore to HDMI or the headphone\n"
                "jack; it needs AHI, and brings videocodec along.\n\n"
                "vcjpeg.datatype decodes JPEG pictures of about\n"
                "2 megapixels and more on the VideoCore, for every\n"
                "program that loads pictures through datatypes;\n"
                "the rest stay with your JPEG datatype.  It\n"
                "brings videocodec along.\n\n"
                @askoptions-help
            )
            (choices
                #choice-gic400
                #choice-bcmpcie
                "openpci.library (for identify.library)"
                "nvme.device     (NVMe storage)"
                "videocodec      (video, experimental)"
                "videocore.audio (sound, experimental)"
                "vcjpeg.datatype (JPEG, experimental)"
            )
            (default #features-default)
        )
    )
)

(set #sel-gic400      (IN #features 0))
(set #sel-bcmpcie     (IN #features 1))
(set #install-openpci (IN #features 2))
(set #install-nvme    (IN #features 3))
(set #install-vchiq   (IN #features 4))
(set #install-ahi     (IN #features 5))
(set #install-vcjpeg  (IN #features 6))
(if (OR #install-ahi #install-vcjpeg) (set #install-vchiq 1))

; Another openpci.library is replaced only when the user says so.
(if (AND #install-openpci #openpci-other)
    (set #install-openpci
        (askbool
            (prompt
                (cat
                    "Another openpci.library is installed in\n"
                    "LIBS: - most likely the driver of a real PCI\n"
                    "board (Mediator, Prometheus, G-REX ...).\n\n"
                    "Installing this one replaces it, and that\n"
                    "board's software stops working.\n\n"
                    "Replace it anyway?"
                )
            )
            (help
                "This openpci.library forwards the openpci API\n"
                "to bcmpcie.library, the Pi's PCIe bus.  Only\n"
                "one openpci.library can be installed; keep the\n"
                "one you have if a PCI board uses it.\n\n"
                @askbool-help
            )
            (default 0)
        )
    )
)

; ---------------------------------------------------------------------------
; Dependency resolution (union of explicit selection and derived needs)
; ---------------------------------------------------------------------------
(set #need-bcmpcie (OR #sel-bcmpcie #install-xhci #install-nvme #install-openpci))

; lspci, the PCIe diagnostic tool, comes with bcmpcie.library.  C/emu68check
; LSPCI tells whose C:lspci is installed, with the RCs of OPENPCI.  Another one
; is most likely a PCI board's, so it is replaced only when the user says so; a
; NOVICE keeps it.
(set #lspci-rc (run "C/emu68check LSPCI" (safe)))
(set #lspci-other (AND (<> #lspci-rc 0) (<> #lspci-rc 10)))
(set #install-lspci #need-bcmpcie)
(if (AND #install-lspci #lspci-other)
    (if (= @user-level 0)
        (set #install-lspci 0)
        (set #install-lspci
            (askbool
                (prompt
                    (cat
                        "Another lspci is installed in C:, most likely\n"
                        "a PCI board's (Mediator, Prometheus, G-REX).\n\n"
                        "The one that comes with bcmpcie.library\n"
                        "lists the Pi's PCIe bus instead.\n\n"
                        "Replace it?"
                    )
                )
                (help
                    "Answer No to keep your lspci as it is;\n"
                    "bcmpcie.library is installed either way.\n\n"
                    @askbool-help
                )
                (default 0)
            )
        )
    )
)

; gic400 is needed by every DRIVER, so install it like any other library in the
; stack whenever one is selected.  P_copyver still asks before replacing a newer
; LIBS: copy.  Note the LIBS: copy goes unused on a machine whose Emu68 supplies
; gic400.library from its ROM board (that copy is already in exec's library
; list, so OpenLibrary never reaches LIBS:) - the closing message says so.  The
; bundled stack on its own does not need it.
(set #install-gic400 (OR #need-bcmpcie #install-genet #install-vchiq #sel-gic400))

; The stack can be installed with no genet at all (an Ethernet SANA-II card is
; reason enough), so it counts as a component in its own right.
(set #any-component (OR #install-gic400 #install-stack))

; Nothing selected at all - nothing to do.
(if (NOT #any-component)
    (
        (message
            (cat
                "No components were selected, so nothing has\n"
                "been installed.\n\n"
                "Run the installer again and select at least\n"
                "one component."
            )
        )
        (exit (quiet))
    )
)

; ---------------------------------------------------------------------------
; Disk-space check (safety net - the binaries are small).  genet and its tools
; come from a different subtree per variant, so size the chosen one.
; ---------------------------------------------------------------------------
(set #need-libs 0)
(set #need-devs 0)
(set #need-c 0)
(if #install-gic400  (set #need-libs (+ #need-libs (getsize "LIBS/gic400.library"))))
(if #need-bcmpcie    (set #need-libs (+ #need-libs (getsize "LIBS/bcmpcie.library"))))
(if #install-openpci (set #need-libs (+ #need-libs (getsize "LIBS/openpci.library"))))
(if #usb-context     (set #need-devs (+ #need-devs (getsize "DEVS/USBHardware/xhci.device"))))
(if #usb-legacy      (set #need-devs (+ #need-devs (getsize "DEVS/USBHardware/xhci-legacy.device"))))
(if #net-netdev      (set #need-devs (+ #need-devs (getsize "DEVS/Networks/genet.device"))))
(if #net-sana2
    (
        (set #need-devs (+ #need-devs (getsize "Storage/DEVS/Networks/genet.device")))
        (set #need-c    (+ #need-c (getsize "Storage/C/genet-stats")))
    )
)
(if #install-nvme
    (
        (set #need-devs (+ #need-devs (getsize "DEVS/nvme.device")))
        (set #need-c    (+ #need-c (getsize "C/nvmeinfo")))
        (set #need-c    (+ #need-c (getsize "C/nvmeadm")))
    )
)
(if #install-lspci   (set #need-c (+ #need-c (getsize "C/lspci"))))
(if #install-vchiq
    (
        (set #need-devs (+ #need-devs (getsize "DEVS/vchiq.device")))
        (set #need-libs (+ #need-libs (getsize "LIBS/videocodec.library")))
        (set #need-libs (+ #need-libs (getsize "LIBS/videocodec/videocore.codec")))
        (set #need-c    (+ #need-c (getsize "C/VCInfo")))
    )
)
(if #install-ahi
    (
        (set #need-devs (+ #need-devs (getsize "DEVS/AHI/videocore.audio")))
        (set #need-devs (+ #need-devs (getsize "DEVS/AudioModes/VIDEOCORE")))
    )
)
; SYS:Classes and SYS:Storage are on the system volume, with SYS:Libs: counted with LIBS:.
(if #install-vcjpeg
    (
        (set #need-libs (+ #need-libs (getsize "Classes/DataTypes/vcjpeg.datatype")))
        (set #need-libs (+ #need-libs (getsize "Storage/DataTypes/VCJPEG")))
    )
)
(if #net-netdev (set #need-c (+ #need-c (getsize "C/netdev-stats"))))
(if #install-stack
    (
        (set #need-libs (+ #need-libs (getsize "LIBS/bsdsocket.library")))
        (set #need-c    (+ #need-c (getsize "C/netinfo")))
        (set #need-c    (+ #need-c (getsize "C/GetNetStatus")))
        (set #need-c    (+ #need-c (getsize "C/ShowNetStatus")))
        (set #need-c    (+ #need-c (getsize "C/mdns")))
        (set #need-c    (+ #need-c (getsize "C/AddNetInterface")))
        (set #need-c    (+ #need-c (getsize "C/RemoveNetInterface")))
        (set #need-c    (+ #need-c (getsize "C/NetShutdown")))
        (set #need-c    (+ #need-c (getsize "C/arp")))
        (set #need-c    (+ #need-c (getsize "C/ping")))
        (set #need-c    (+ #need-c (getsize "C/traceroute")))
        (set #need-c    (+ #need-c (getsize "C/NetLogViewer")))
        (set #need-c    (+ #need-c (getsize "C/NetLogViewer.info")))
        (set #need-c    (+ #need-c (getsize "C/NetSpeed")))
        (set #need-c    (+ #need-c (getsize "C/NetSpeed.info")))
    )
)

; getdiskspace returns -1 when it cannot tell; only abort on a real shortfall.
(set #free (getdiskspace "LIBS:"))
(if (AND (> #need-libs 0) (AND (>= #free 0) (< #free #need-libs)))
    (abort "Not enough free space in LIBS: to install\n"
           "the selected libraries.")
)
(set #free (getdiskspace "DEVS:"))
(if (AND (> #need-devs 0) (AND (>= #free 0) (< #free #need-devs)))
    (abort "Not enough free space in DEVS: to install\n"
           "the selected drivers.")
)
(set #free (getdiskspace "C:"))
(if (AND (> #need-c 0) (AND (>= #free 0) (< #free #need-c)))
    (abort "Not enough free space in C: to install\n"
           "the selected tools.")
)

; ---------------------------------------------------------------------------
; Summary - the last screen before anything is copied, at every user level: a
; NOVICE sees what the defaults chose, the others also the libraries their
; choices pulled in.  One line per topic, at most seven, so the screen stays
; within its ten lines.  Proceed copies; Abort leaves the system as it was.
; ---------------------------------------------------------------------------
(set #sum "Ready to install (Proceed starts copying):\n\n")
(if #install-xhci
    (
        (set #sum-usb "xhci-legacy.device")
        (if #usb-context
            (if #usb-legacy
                (set #sum-usb "xhci.device, xhci-legacy.device")
                (set #sum-usb "xhci.device")
            )
        )
        (set #sum (cat #sum "* USB: " #sum-usb "\n"))
    )
)
(if #net-netdev (set #sum (cat #sum "* Ethernet: genet.device (netdev)\n")))
(if #net-sana2  (set #sum (cat #sum "* Ethernet: genet.device (SANA-II)\n")))
(if #install-stack
    (
        (set #sum-stack ", replacing your stack")
        (if #stack-ours (set #sum-stack ", an update"))
        (if (= #bsd-rc 10) (set #sum-stack ""))
        (set #sum (cat #sum "* TCP/IP: lwip-amiga" #sum-stack "\n"))
    )
)
(if #install-nvme (set #sum (cat #sum "* NVMe: nvme.device, nvmeinfo, nvmeadm\n")))
(if #install-gic400
    (
        (set #sum-libs "gic400")
        (if #need-bcmpcie (set #sum-libs (cat #sum-libs ", bcmpcie")))
        (if #install-openpci (set #sum-libs (cat #sum-libs ", openpci")))
        (set #sum (cat #sum "* Libraries: " #sum-libs "\n"))
    )
)
(if #install-lspci (set #sum (cat #sum "* lspci (PCIe diagnostic tool)\n")))
(if #install-vchiq
    (
        (set #sum-video "videocodec")
        (if #install-ahi (set #sum-video (cat #sum-video ", videocore.audio")))
        (if #install-vcjpeg (set #sum-video (cat #sum-video ", vcjpeg")))
        (set #sum (cat #sum "* Video: " #sum-video "\n"))
    )
)
(message #sum (all))

; ---------------------------------------------------------------------------
; Installation
; ---------------------------------------------------------------------------
(complete 0)

; Track whether the installed bcmpcie.library is the bundled build, so lspci can
; follow it (lspci comes only with bcmpcie, so this is always set when lspci is
; on).
(set #bundled-bcmpcie 0)

; Libraries -> LIBS:
(if #install-gic400  (P_copyver "LIBS/gic400.library"  "LIBS:" "gic400.library"))
(if #need-bcmpcie    (set #bundled-bcmpcie (P_copyver "LIBS/bcmpcie.library" "LIBS:" "bcmpcie.library")))
(if #install-openpci (P_copyver "LIBS/openpci.library" "LIBS:" "openpci.library"))
(complete 30)

; Devices -> DEVS:
; The two xhci lines have their own names, so each is a version-checked copy; the
; 6.x driver replacing a 5.x xhci.device is an upgrade by version.
(if #install-xhci (makedir "DEVS:USBHardware"))
(if #usb-context (P_copyver "DEVS/USBHardware/xhci.device" "DEVS:USBHardware" "xhci.device"))
(if #usb-legacy  (P_copyver "DEVS/USBHardware/xhci-legacy.device" "DEVS:USBHardware" "xhci-legacy.device"))

; genet.device - force-copy the chosen variant (a variant switch is a same-name
; version change, so a version-checked copy would ask before the downgrade).
(if #install-genet
    (
        (makedir "DEVS:Networks")
        (if #net-netdev
            (P_copyforce "DEVS/Networks/genet.device" "DEVS:Networks")
            (P_copyforce "Storage/DEVS/Networks/genet.device" "DEVS:Networks")
        )
    )
)

; Counter tools pair with the DRIVER, not with the stack: netdev-stats speaks the
; netdev command set straight to the device, genet-stats the SANA-II one, so each
; is useless against the other variant.
(if #net-netdev (P_copyforce "C/netdev-stats" "C:"))
(if #net-sana2  (P_copyforce "Storage/C/genet-stats" "C:"))

(if #install-nvme
    (
        (set #bundled-nvme (P_copyver "DEVS/nvme.device" "DEVS:" "nvme.device"))
        ; nvmeinfo / nvmeadm - diagnostic and admin tools, kept in lockstep with the
        ; driver: install them when the installed driver is the bundled build, or
        ; when they are missing entirely (keeping a newer driver must not leave the
        ; user with no tools).  Same rule as lspci below.
        (if (OR #bundled-nvme
                (OR (NOT (exists "C:nvmeinfo" (noreq)))
                    (NOT (exists "C:nvmeadm" (noreq)))))
            (
                (P_copyforce "C/nvmeinfo" "C:")
                (P_copyforce "C/nvmeadm" "C:")
            )
        )
    )
)

; VideoCore video: vchiq.device, videocodec.library and its backend in
; LIBS:videocodec/, and VCInfo, kept in lockstep with the library as nvme's
; tools are with the driver.  The test rig (Developer/Tools: VPUTool, VPUPlay)
; and the examples (Developer/Examples/videocodec) stay in the archive.
(if #install-vchiq
    (
        (P_copyver "DEVS/vchiq.device" "DEVS:" "vchiq.device")
        (set #bundled-videocodec (P_copyver "LIBS/videocodec.library" "LIBS:" "videocodec.library"))
        (makedir "LIBS:videocodec")
        (P_copyver "LIBS/videocodec/videocore.codec" "LIBS:videocodec" "videocore.codec")
        (if (OR #bundled-videocodec (NOT (exists "C:VCInfo" (noreq))))
            (P_copyforce "C/VCInfo" "C:")
        )
    )
)

; VideoCore sound: the AHI driver and its mode file, always replaced by the
; bundled pair (lib_Version is AHI's interface number, not a release to compare).
(if #install-ahi
    (
        (if (NOT (exists "DEVS:AHI" (noreq))) (makedir "DEVS:AHI"))
        (if (NOT (exists "DEVS:AudioModes" (noreq))) (makedir "DEVS:AudioModes"))
        (P_copyforce "DEVS/AHI/videocore.audio" "DEVS:AHI")
        (P_copyforce "DEVS/AudioModes/VIDEOCORE" "DEVS:AudioModes")
    )
)

; VideoCore pictures: the class, and its descriptor in SYS:Storage/DataTypes, not
; DEVS:DataTypes.  datatypes.library tries, among the descriptors with a function
; and no mask, the one added last first, so VCJPEG must be added after the
; system's JPEG descriptors: from S:User-Startup, which runs after
; Startup-Sequence's AddDataTypes REFRESH.  Removing the line restores them.
(if #install-vcjpeg
    (
        (P_copyver "Classes/DataTypes/vcjpeg.datatype" "SYS:Classes/DataTypes" "vcjpeg.datatype")
        (if (NOT (exists "SYS:Storage/DataTypes" (noreq))) (makedir "SYS:Storage/DataTypes"))
        (P_copyforce "Storage/DataTypes/VCJPEG" "SYS:Storage/DataTypes")
        (startup "vcjpeg.datatype"
            (prompt
                (cat
                    "vcjpeg.datatype takes JPEG pictures once its\n"
                    "descriptor is added at boot, after the\n"
                    "system's.  Add this line to S:User-Startup?\n\n"
                    "AddDataTypes SYS:Storage/DataTypes/VCJPEG QUIET"
                )
            )
            (help @startup-help)
            (command "AddDataTypes SYS:Storage/DataTypes/VCJPEG QUIET")
        )
    )
)
(complete 55)

; Bundled stack -> LIBS:bsdsocket.library (force-replaced), its
; tools, and the configuration.  Config files land only when absent - a
; reinstall never clobbers a live configuration: the stack-wide template in
; ENVARC:netstack.prefs, the sample interface file in DEVS:NetInterfaces/
; (Roadshow model: interfaces are added at boot by AddNetInterface), and
; S:Network-Startup with the boot line, executed from a marker-guarded
; User-Startup block (the startup command asks first).
(if #install-stack
    (
        (P_copyforce "LIBS/bsdsocket.library" "LIBS:")
        (P_copyforce "C/netinfo" "C:")
        (P_copyforce "C/GetNetStatus" "C:")
        (P_copyforce "C/ShowNetStatus" "C:")
        (P_copyforce "C/mdns" "C:")
        (P_copyforce "C/AddNetInterface" "C:")
        (P_copyforce "C/RemoveNetInterface" "C:")
        (P_copyforce "C/NetShutdown" "C:")
        (P_copyforce "C/arp" "C:")
        (P_copyforce "C/ping" "C:")
        (P_copyforce "C/traceroute" "C:")
        (P_copyforce "C/NetLogViewer" "C:")
        (P_copyforce "C/NetLogViewer.info" "C:")
        (P_copyforce "C/NetSpeed" "C:")
        (P_copyforce "C/NetSpeed.info" "C:")
        (if (NOT (exists "ENVARC:netstack.prefs" (noreq)))
            (copyfiles
                (prompt "Installing the default netstack.prefs...")
                (help @copyfiles-help)
                (source "ENVARC/netstack.prefs.default")
                (dest "ENVARC:")
                (newname "netstack.prefs")
            )
        )
        ; The boot line globs this drawer, so it has to exist even when no
        ; interface file is installed alongside it (a SANA-II card the user
        ; describes themselves).
        (makedir "DEVS:NetInterfaces")
        ; Reference copy of the commented sample.  SYS:Storage is the inactive
        ; drawer, so it can never feed the boot wildcard - it is the template
        ; for writing a file for some other Ethernet device.
        (copyfiles
            (prompt "Installing the sample interface file...")
            (help @copyfiles-help)
            (source "Storage/NetInterfaces/genet")
            (dest "SYS:Storage/NetInterfaces")
        )
        ; The live interface file names networks/genet.device, and TYPE defaults
        ; to AUTO - which has to open the device to probe it - so write it only
        ; when a genet.device is actually installed.  One file serves both
        ; variants: the probe tells netdev and SANA-II apart by itself.
        (if (AND #install-genet (NOT (exists "DEVS:NetInterfaces/genet" (noreq))))
            (copyfiles
                (prompt "Installing DEVS:NetInterfaces/genet (DHCP)...")
                (help @copyfiles-help)
                (source "Storage/NetInterfaces/genet")
                (dest "DEVS:NetInterfaces")
            )
        )
        (if (NOT (exists "S:Network-Startup" (noreq)))
            (textfile
                (prompt "Creating S:Network-Startup (boot-time setup)...")
                (help @copyfiles-help)
                (dest "S:Network-Startup")
                (append "; $VER: Network-Startup 1.0 (emu68 driver stack)\n")
                (append "; Adds every interface configured in DEVS:NetInterfaces/.\n")
                (append "FailAt 30\n")
                (append "C:AddNetInterface DEVS:NetInterfaces/~(#?.info) QUIET\n")
            )
        )
        (startup "emu68 network"
            (prompt
                (cat
                    "The network interfaces are brought up at boot\n"
                    "by S:Network-Startup.  Add these lines to\n"
                    "S:User-Startup?\n\n"
                    "If EXISTS S:Network-Startup\n"
                    "  Execute S:Network-Startup\n"
                    "EndIf"
                )
            )
            (help @startup-help)
            (command "If EXISTS S:Network-Startup\nExecute S:Network-Startup\nEndIf")
        )
    )
)

(complete 80)

; Diagnostic tool -> C:.  Keep our lspci in lockstep with bcmpcie.library: install
; it when the installed bcmpcie is the bundled build.  Skip only when a newer
; bcmpcie was kept AND our lspci already exists - that tool pairs with the
; library we left in place.  With no lspci, or another one the user agreed to
; replace (#install-lspci is clear when they did not), always install it.
(if #install-lspci
    (if (OR #bundled-bcmpcie (<> #lspci-rc 0))
        (P_copyforce "C/lspci" "C:")
    )
)
(complete 100)

; ---------------------------------------------------------------------------
; Done
; ---------------------------------------------------------------------------
; One headline, then at most one two-line note per topic that was installed,
; then the ReadMe pointer.  The worst case (USB + Ethernet + gic400 or video) is
; ten rendered lines - the whole budget.  Any note added here must displace
; another one: the video note displaces the gic400 one (video installs gic400).
;
; That holds because at most ONE usb note and ONE net note can fire.  The usb
; notes are an if/else chain; the two net notes are not exclusive: since
; 2.1 the SANA-II driver can be installed together with the bundled stack, so
; the SANA-II note is explicitly suppressed when the stack note already
; covers the machine.  Do not drop that condition.
(set #done-msg "Installation complete - reboot to activate.\n\n")
; A Poseidon 4.x still set to its old xhci.device (5.x) comes first: it has a step to do -
; a must when the 6.x driver replaced that file (#usb-context here means the guard
; was answered Yes), else only to get the update.
(if (AND #usb-legacy (AND #xhci-old-5x #psd-classic))
    (if #usb-context
        (set #done-msg
            (cat #done-msg
                "* Poseidon: select xhci-legacy.device in\n"
                "  Trident - xhci.device is now the 6.x one\n"
            )
        )
        (set #done-msg
            (cat #done-msg
                "* Poseidon: select xhci-legacy.device in\n"
                "  Trident to use the update - see the ReadMe\n"
            )
        )
    )
    (if (AND #usb-context #usb-legacy)
        (set #done-msg
            (cat #done-msg
                "* USB: xhci.device (Neptune), xhci-legacy.device\n"
                "  (Poseidon 4.x) - see the ReadMe\n"
            )
        )
        (if #usb-context
            (set #done-msg
                (cat #done-msg
                    "* xhci.device needs Neptune 6.x; add its units\n"
                    "  in Neptune USB - see the ReadMe\n"
                )
            )
            (if #usb-legacy
                (set #done-msg
                    (cat #done-msg
                        "* xhci-legacy.device needs a USB stack; add\n"
                        "  its units in Trident or Neptune USB\n"
                    )
                )
            )
        )
    )
)
(if #install-stack
    (set #done-msg
        (cat #done-msg
            "* TCP/IP: interfaces live in DEVS:NetInterfaces,\n"
            "  added at boot by S:Network-Startup (DHCP)\n"
        )
    )
)
(if (AND #net-sana2 (NOT #install-stack))
    (set #done-msg
        (cat #done-msg
            "* point a TCP/IP stack (Roadshow) at\n"
            "  genet.device unit 0 to carry traffic\n"
        )
    )
)
(if #install-ahi
    (set #done-msg
        (cat #done-msg
            "* sound: after a reboot, pick a VideoCore mode\n"
            "  in the AHI preferences\n"
        )
    )
)
(if #install-vchiq
    (set #done-msg
        (cat #done-msg
            "* video: dtoverlay=cma in the Pi's config.txt,\n"
            "  gpu_mem=192 for large pictures - see ReadMe\n"
        )
    )
    (if #install-gic400
        (set #done-msg
            (cat #done-msg
                "* LIBS:gic400.library goes unused if Emu68\n"
                "  supplies its own copy - harmless\n"
            )
        )
    )
)
(set #done-msg (cat #done-msg "\nSee the ReadMe for usage notes."))
(message #done-msg (all))
; Quiet exit: running off the end (or a plain (exit)) would add the Installer's
; own "<APPNAME> can be found in <@default-dest>" report after this summary.
(exit (quiet))
